{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtOptions": {
    "Authority": "https://localhost:5151",
    "RequireHttpsMetadata": false,

    "ValidIssuer": "https://localhost:5151",
    "ValidAudience": "api",

    "ClockSkewSeconds": 0,

    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "itemcatalog-route": {
        "ClusterId": "itemcatalog-cluster",
        "Match": {
          "Path": "/itemcatalog-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ],
        "AuthorizationPolicy": "ShopOwner"
      },
      "authservice-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "itemcatalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5150"
          }
        }
      },
      "authservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5151"
          }
        }
      }
    }
  }
}
