{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtOptions": {
    "Authority": "https://localhost:5151",
    "RequireHttpsMetadata": false,

    "ValidIssuer": "https://localhost:5151",
    "ValidAudience": "api",

    "ClockSkewSeconds": 5,

    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {

      // public routes
      "auth-login-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/users/login"
        },
        "Transforms": [{ "PathPattern": "users/login" }]
      },

      "auth-register-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/users/register"
        },
        "Transforms": [{ "PathPattern": "users/register" }]
      },

      "auth-refresh-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/tokens/refresh"
        },
        "Transforms": [{ "PathPattern": "tokens/refresh" }]
      },

      "openid-config-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/.well-known/openid-configuration"
        },
        "Transforms": [{ "PathPattern": ".well-known/openid-configuration" }]
      },

      "jwks-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/.well-known/jwks.json"
        },
        "Transforms": [ { "PathPattern": ".well-known/jwks.json" } ]
      },

      // Authenticated routes 
      "itemcatalog-route": {
        "ClusterId": "itemcatalog-cluster",
        "Match": {
          "Path": "/itemcatalog-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ],
        "AuthorizationPolicy": "ShopOwner"
      },

      "authservice-route": {
        "ClusterId": "authservice-cluster",
        "Match": {
          "Path": "/auth-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {

      "itemcatalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5150"
          }
        }
      },

      "authservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5151"
          }
        }
      }
    }
  }
}
